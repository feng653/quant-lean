* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep source and CI files consistent across all three runner platforms.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Preserve native Windows script line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never convert line endings
*.db binary
*.db-journal binary
*.db-wal binary
*.db-shm binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.jar binary
*.zip binary
*.gz binary
*.tar binary
*.pyc binary
