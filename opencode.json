{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "req-executor",
  "permission": {
    "process": "deny",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git commit *": "allow",
      "rm -rf *": "ask"
    },
    "task": {
      "*": "allow"
    },
    "webfetch": "allow",
    "external_directory": "allow"
  }
}
