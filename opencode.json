{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tech-lead",
  "permission": {
    "process": "deny",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git commit *": "allow",
      "rm -rf *": "ask"
    },
    "task": {
      "*": "allow"
    },
    "webfetch": "allow",
    "external_directory": "allow"
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1"
      }
    }
  }
}
